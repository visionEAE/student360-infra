# Copy to .env and adjust. .env is git-ignored. Every service repo reads the same file through
# the Makefile (`make run-<service>`), so this is the single place for local credentials.

# --- PostgreSQL (infra/docker-compose.yml) ---
POSTGRES_DB=student360
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
ADMINER_PORT=8090

# One database user per service; each is confined to its own schema.
AUTH_DB_PASSWORD=change-me-auth
CORE_DB_PASSWORD=change-me-core
LMS_DB_PASSWORD=change-me-lms
SUPPORT_DB_PASSWORD=change-me-support

# --- auth-service JWT signing key (RSA 2048, PEM). Generate with `make keys`. ---
JWT_PRIVATE_KEY_PATH=../student360-infra/secrets/jwt-private.pem
JWT_KEY_ID=student360-dev-2026-08
JWT_ISSUER=http://localhost:8081

# --- Service-to-service token (stage 1: HS256 with a dev secret shared by the services) ---
SERVICE_TOKEN_SECRET=change-me-at-least-32-bytes-long-secret-value

# --- Pseudonymisation key used by support-service for wellbeing entries ---
PSEUDONYM_SECRET=change-me-another-32-bytes-long-secret-value
